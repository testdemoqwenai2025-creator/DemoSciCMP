# SciCMP Environment Configuration
# Copy this file to .env and fill in your values

# Database (if using)
DATABASE_URL=file:./db/custom.db

# GitHub OAuth Configuration
# Get your Client ID from: https://github.com/settings/developers
# Create OAuth App with callback URL matching your deployment
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here

# Optional: Analytics (future)
# NEXT_PUBLIC_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags (future)
# NEXT_PUBLIC_ENABLE_BETA_FEATURES=false
# NEXT_PUBLIC_ENABLE_AI_CHAT=false
